alias smt create_multiple_task
## functions
function dir --wraps /usr/sbin/dir
    if test (pwd -P) = /home/tree/project/extensions
        command dir --hide=tauri-shorclip $argv
        return
    end

    command dir $argv
end

# notify
function nf --wraps /home/tree/Config/data/fish/functions/notify.fish
    /home/tree/Config/data/fish/functions/notify.fish $argv
end
# zsh에서 <commit> 자리 채우는 형태는 fish 함수로 구현
function gsho
  git show $argv --stat
end

# zsh의 복잡한 포맷은 fish에서 따옴표/이스케이프만 정리
alias glo 'git log --graph --format=format:"%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%an%C(reset)%C(bold yellow)%d%C(reset) %C(dim white)- %s%C(reset)" --all'

# tmux helpers
set -gx TMUX_CONF /home/tree/Config/data/tmux/tmux.conf
alias tmn "tmux -f $TMUX_CONF new -s"
alias tmg "tmux -f $TMUX_CONF attach-session -t"
alias tmk "tmux -f $TMUX_CONF kill-session -t"
alias tmc "tmux -f $TMUX_CONF switch-client -t"

function tmcc
  if tmux -f $TMUX_CONF has-session -t claude 2>/dev/null
    tmux -f $TMUX_CONF attach -t claude
  else
    tmux -f $TMUX_CONF new -s claude
  end
end

# -----------------------------
# env / PATH
# -----------------------------
set -gx LANG ko_KR.UTF-8
set -gx LC_ALL ko_KR.UTF-8

# DISPLAY (WSLg)
set -gx DISPLAY :0
set -gx WAYLAND_DISPLAY wayland-0# ZED
set -gx ZED_ALLOW_EMULATED_GPU 1

# ANDROID / JAVA
set -gx ANDROID_HOME $HOME/Android
set -gx JAVA_HOME /usr/lib/jvm/java-8-openjdk
set -gx PATH $ANDROID_HOME/emulator $ANDROID_HOME/tools $ANDROID_HOME/tools/bin \
            $ANDROID_HOME/cmdline-tools/latest $ANDROID_HOME/cmdline-tools/latest/bin \
            $ANDROID_HOME/platform-tools $PATH

# PNPM
set -gx PNPM_HOME /home/tree/.local/share/pnpm
if not contains $PNPM_HOME $PATH
  set -gx PATH $PNPM_HOME $PATH
end

# DENO
set -gx DENO_INSTALL /home/tree/.deno
set -gx PATH $DENO_INSTALL/bin $PATH

# NVM (fish용: bass/fnm 미사용 상태라 최소 이식)
set -gx NVM_DIR $HOME/.nvm
set -q nvm_default_version; or set -gx nvm_default_version v25.8.1

# ENCORE
set -gx ENCORE_INSTALL /home/tree/.encore
set -gx PATH $ENCORE_INSTALL/bin $PATH

# Cargo / extra PATH들
set -gx PATH $HOME/.cargo/bin $PATH
set -gx PATH /home/tree/.local/share/bob/nvim-bin $PATH
set -gx PATH /home/tree/project/git_date_Change/src/ $PATH

# -----------------------------
# external init (starship / zoxide / atuin / conda)
# -----------------------------
# starship
starship init fish | source

# zoxide
zoxide init fish | source

# atuin (fish init)
atuin init fish | source

# conda (fish hook)
if test -f /home/tree/miniconda3/bin/conda
  /home/tree/miniconda3/bin/conda "shell.fish" "hook" 2>/dev/null | source
end

# -----------------------------
# automate my process (function)
# -----------------------------
function autoUpdate
  cd ~/config; and git pull
  cd ~/study/myNote; and git pull
  cd ~/project/tenderMono; and git pull
  cd ~
end

# zsh의 up='eval "$(ssh-agent -s)" && ssh-add ~/.ssh/id_rsa && autoUpdate'
function up
  eval (ssh-agent -c) >/dev/null 2>&1
  ssh-add ~/.ssh/id_rsa
  autoUpdate
end

# jujutsu setup 
jj util completion fish | source
# -----------------------------
# ollama auto-start
# -----------------------------
if not pgrep -f "ollama serve" >/dev/null
  nohup ollama serve > ~/.ollama.log 2>&1 &
end


# codex preflight gate + wrapper
function codex-normal
  command codex --dangerously-bypass-approvals-and-sandbox "$prompt"
end
function codex-run
  set override ~/ai/codex/AGENTS.override.md
  if not test -f $override
    echo "BLOCK: AGENTS.override.md 없음: $override"
    return 1
  end

  set workspace_root (pwd -P)
  set user_msg (string join " " -- $argv)
  set prompt "~/ai/codex/AGENTS.override.md를 먼저 읽고, /home/tree/project/work_helper의 작업 방식을 현재 저장소에서 그대로 따르는 코딩 에이전트로 행동해.
- 현재 세션은 manager session이며 danger-full-access sandbox에서 실행된다.
- manager session은 work_helper workflow 관리와 산출물 생성을 담당하고, 실제 구현은 work_helper 하위 Codex 세션에 위임한다.
- 구현이 필요하면 /home/tree/project/work_helper를 통해 별도 하위 Codex 세션을 열어 위임한다.
- 하위 Codex 세션은 CODEXO_WORKSPACE_ROOT 이하 workspace만 사용해야 한다.
- 반드시 Plan mode로 시작해서 작업 계획을 먼저 확정한다.
- 코드 추가/수정/개선 요청이면 `request -> init(프로젝트가 아직 없을 때만 1회) -> plan -> analyze -> build -> check` 순서를 지킨다.
- `plan` 단계에서 반드시 `job.md`를 만들거나 갱신하고, 요구사항, 병렬 처리 가능한 작업 단위, 검증 계획을 적는다.
- `analyze` 단계에서 요청과 코드를 분석한 뒤 반드시 `drafts.yaml`을 만든다.
- `build` 단계에서는 `drafts.yaml`을 구현의 source of truth로 사용한다.
- 독립적인 작업은 병렬 agent/worker로 나누되, 각 worker의 파일 책임 범위를 분리해서 충돌을 피한다.
- `check` 단계에서는 테스트, 실행, 필요한 실제 검증까지 끝내고 결과를 보고한다.
- 특별한 이유가 없으면 중간 승인 없이 끝까지 진행한다.
- 사용자의 원래 요청은 아래 msg에 있다.
msg: $user_msg"
  command env CODEXO_WORKSPACE_ROOT="$workspace_root" WORK_HELPER_CODEX_SANDBOX=danger-full-access WORK_HELPER_CODEX_APPROVAL_POLICY=never \
    codex --ask-for-approval never exec --cd "$workspace_root" --sandbox danger-full-access --skip-git-repo-check --color never "$prompt"
end

alias codex codex-normal
alias codexo codex-run
